# ============================================================
# ReviewGraph — Environment Configuration Template
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# ============================================================

# --- Neo4j Configuration ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password_here

# --- Application Settings ---
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
LOG_LEVEL=INFO

# --- Data Paths ---
DATA_RAW_PATH=../data/raw
DATA_PROCESSED_PATH=../data/processed
DATA_SAMPLE_PATH=../data/sample
MODELS_PATH=../models

# --- ML Model Settings ---
MODEL_FILENAME=review_classifier.pkl
EMBEDDING_MODEL=all-MiniLM-L6-v2
FAISS_INDEX_PATH=../models/faiss_index.bin
EMBEDDINGS_CACHE_PATH=../models/embeddings_cache.npz

# --- Retrieval Settings ---
SIMILARITY_THRESHOLD=0.75
MAX_GRAPH_TRAVERSAL_DEPTH=3
MAX_RESULTS_PER_QUERY=50
MAX_GRAPH_NODES=200

# --- Dataset Settings ---
DATASET_PATH=../data/external/amazon_reviews_electronics.csv
SAMPLE_DATASET_PATH=../data/sample/sample_reviews.csv

# --- CORS Settings (comma-separated origins) ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Optional: Future LLM Integration (not required for core functionality) ---
# OPENAI_API_KEY=
